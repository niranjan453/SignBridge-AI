POSTGRES_DB=signbridge_db
POSTGRES_USER=signbridge_user
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000
APP_ENV=development

# For Python running directly on the host. Match the password and mapped port above.
# Compose supplies its own DATABASE_URL using the db service hostname.
DATABASE_URL=postgresql+psycopg://signbridge_user:replace-with-a-url-safe-password@localhost:5432/signbridge_db
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ACCESS_TOKEN_MINUTES=30
MEDIA_MAX_BYTES=10485760
PROCESSING_TIMEOUT_SECONDS=10
AI_MODEL_VERSION=mock-1
LOGIN_ATTEMPTS_PER_MINUTE=10
TRANSLATIONS_PER_MINUTE=30
AI_MODEL_NAME=signbridge-mock
AI_CONTEXT_TIMEOUT_SECONDS=2
WS_IDLE_SECONDS=30
WS_FRAMES_PER_SECOND=5
WS_MAX_SESSIONS=16
